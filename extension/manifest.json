{
  "manifest_version": 3,
  "name": "Privacy Sentinel Auto Inspector",
  "version": "1.3.0",
  "description": "Automatic local URL inspection through the Privacy Sentinel Python engine.",
  "minimum_chrome_version": "110",
  "permissions": ["webNavigation", "nativeMessaging", "notifications", "storage", "activeTab"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": { "id": "privacy-sentinel@chinthand18-creator.github.io", "strict_min_version": "121.0" }
  },
  "action": {
    "default_title": "Privacy Sentinel",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
